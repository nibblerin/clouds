#outputs for key endpoints/resources

output "data_bucket" {
  description = "GCS bucket with bronze, silver and quarantine data"
  value = google_storage_bucket.data.name
}

output "function_uri" {
  description = "URL (generated by Google at deploy time) of the Cloud Function that ingests weather data"
  value = google_cloudfunctions2_function.ingest.service_config[0].uri
}

output "scheduler_job" {
  description = "Cloud Scheduler job that triggers the ingestion function every 10 minutes (so as to force a run & to find the job)"
  value = google_cloud_scheduler_job.ingest.name
}

output "bigquery_table" {
  description = "Full name of BigQuery gold table"
  value = "${var.project_id}.${google_bigquery_dataset.gold.dataset_id}.${google_bigquery_table.weather.table_id}"
}

output "secret_id" {
  description = "Secret container ID only (to add it manually later via gcloud with the respective resource)"
  value = google_secret_manager_secret.api_key.secret_id
}

output "service_accounts" {
  description = "Emails of the service accounts created per service"
  value = {
    function = google_service_account.function.email
    build = google_service_account.build.email
    scheduler = google_service_account.scheduler.email
    airflow = google_service_account.airflow.email
  }
}
